---
/**
 * A company logo: a file in src/assets/partners/ (optimised at build time),
 * a remote URL, or — when neither is available — the company name as text.
 */
import { Image } from 'astro:assets';

interface Props {
  logo?: string;
  name: string;
  /** Rendered height hint for local images, in px. */
  height?: number;
  class?: string;
}
const { logo, name, height = 160, class: className } = Astro.props;
const local = import.meta.glob<{ default: ImageMetadata }>('../assets/partners/*.{png,jpg,jpeg,webp,svg}', { eager: true });
const isRemote = !!logo && /^https?:/.test(logo);
const localLogo = logo && !isRemote ? local[`../assets/partners/${logo}`]?.default : undefined;
---
{localLogo ? (
  <Image class={className} src={localLogo} alt={name} height={height} />
) : isRemote ? (
  <img class={className} src={logo} alt={name} loading="lazy" />
) : (
  <span class:list={['logo-wordmark', className]}>{name}</span>
)}

<style>
  .logo-wordmark {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--ink);
    text-align: center;
  }
</style>
