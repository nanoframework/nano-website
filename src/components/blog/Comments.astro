---
/**
 * Comments via giscus (https://giscus.app): stored in GitHub Discussions, readers sign in with GitHub.
 *
 * To turn on:
 *   1. Enable Discussions on the repo and create a "Blog comments" category (Announcement type).
 *   2. Install the giscus app on the repo: https://github.com/apps/giscus
 *   3. Generate the ids at https://giscus.app and fill in GISCUS below.
 */
const GISCUS = {
  repo: '', // e.g. 'nanoframework/nano-website'
  repoId: '',
  category: 'Blog comments',
  categoryId: '',
};
const enabled = GISCUS.repo && GISCUS.repoId && GISCUS.categoryId;
---
<section class="comments" aria-labelledby="comments-title">
  <h2 id="comments-title">Comments</h2>
  <p>Comments are powered by GitHub Discussions. Sign in with GitHub to join in.</p>
  {enabled ? (
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo={GISCUS.repo}
      data-repo-id={GISCUS.repoId}
      data-category={GISCUS.category}
      data-category-id={GISCUS.categoryId}
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="light"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
  ) : (
    <div class="comments__todo">Comments switch on once giscus is configured (see <code>Comments.astro</code>).</div>
  )}
</section>

<style>
  .comments {
    margin-top: 40px;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .comments h2 {
    font-size: 22px;
    font-weight: 700;
  }
  .comments > p {
    margin: 8px 0 16px;
    font-size: 15px;
    color: var(--ink-2);
  }
  .comments__todo {
    padding: 24px;
    border-radius: 10px;
    border: 1px dashed #c9c7dc;
    font-size: 14px;
    color: var(--ink-3);
    text-align: center;
  }
</style>
