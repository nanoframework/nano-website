---
import { Code, Bug, Wifi, Heart } from '@lucide/astro';

const features = [
  {
    icon: Code,
    title: 'Your C# skills, unchanged',
    text: 'APIs aligned with .NET IoT. Generics, familiar namespaces and NuGet packages — no new language to learn.',
  },
  {
    icon: Bug,
    title: 'Real debugging on real hardware',
    text: 'Breakpoints, stepping and watches on the device, from Visual Studio or VS Code. No printf archaeology.',
  },
  {
    icon: Wifi,
    title: 'Connected by default',
    text: 'Wi-Fi, Ethernet and AT modems, TLS 1.3, MQTT, and SDKs for Azure and AWS.',
  },
  {
    icon: Heart,
    title: 'Open, community-driven',
    text: 'Built in the open on GitHub by contributors, partners and silicon vendors. Successor to .NET Micro Framework.',
  },
];
---
<section class="section">
  <div class="container">
    <p class="eyebrow">Why .NET nanoFramework</p>
    <h2 class="section-title">Embedded development that feels like the rest of your .NET work.</h2>
    <div class="grid features" style="--min: 250px">
      {features.map((f) => (
        <div class="feature">
          <f.icon size={28} stroke-width={1.8} color="var(--nf-teal-text)" aria-hidden="true" />
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    margin-top: 56px;
    gap: 24px;
  }
  .feature {
    padding: 28px;
    border-radius: var(--radius);
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .feature h3 {
    margin: 18px 0 8px;
    font-size: 19px;
    font-weight: 700;
  }
  .feature p {
    font-size: 15px;
    color: var(--ink-2);
  }
</style>
