---
import Logo from '../Logo.astro';
import BrandIcon from '../BrandIcon.astro';
import { SPONSORS, LINKS } from '../../data/site';
---
<section id="sponsor" class="section section--dark sponsor">
  <div class="sponsor__bar" aria-hidden="true"></div>
  <div class="container sponsor__inner">
    <div class="sponsor__pitch">
      <p class="eyebrow">Sponsor the project</p>
      <h2 class="section-title">.NET nanoFramework is free. Keeping it that way isn't.</h2>
      <p class="lead">
        The project is built by volunteers and funded entirely by sponsors. Your support pays for build and test
        infrastructure, hardware for the test lab, documentation and learning materials. If .NET nanoFramework is part
        of your product, please help keep it healthy.
      </p>
      <div class="sponsor__ctas">
        <a class="btn btn--primary btn--lg" href={LINKS.githubSponsors}>
          <BrandIcon name="githubsponsors" size={18} />Sponsor on GitHub
        </a>
        <a class="btn btn--ghost-dark btn--lg" href={LINKS.openCollective}>
          <BrandIcon name="opencollective" size={18} />Sponsor on Open Collective
        </a>
      </div>
      <p class="sponsor__note">
        Both go straight to the project. On Open Collective every contribution and expense is public.
        Building a product on .NET nanoFramework? <a href={LINKS.partnerProgram}>Talk to us about partnering</a>.
      </p>
    </div>

    <div class="sponsor__list">
      <h3 class="sponsor__label">Current sponsors – thank you</h3>
      <div class="sponsor__grid">
        {SPONSORS.map((s) => (
          <a class="sponsor__logo" href={s.href} aria-label={s.name}>
            <Logo logo={s.logo} name={s.name} class="sponsor__img" />
          </a>
        ))}
        <a class="sponsor__logo sponsor__logo--empty" href="/support-nanoframework/#sponsor-options">
          <strong>Your logo here</strong>
          <span>Become a sponsor →</span>
        </a>
      </div>
      <div class="sponsor__backers">
        <h3 class="sponsor__label">Backers</h3>
        <!-- TODO: fetch backers from the Open Collective API at build time and render avatars here. -->
        <a href={LINKS.openCollective}>See everyone who backs the project →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .sponsor {
    position: relative;
    overflow: hidden;
  }
  .sponsor__bar {
    position: absolute;
    inset: 0 0 auto 0;
    height: 6px;
    background: linear-gradient(90deg, var(--nf-green), var(--nf-teal) 40%, var(--nf-indigo));
  }
  .sponsor__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: flex-start;
  }
  .sponsor__pitch {
    flex: 1.2 1 480px;
    min-width: 0;
  }
  .sponsor__ctas {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .sponsor__note {
    margin-top: 18px;
    max-width: 560px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--on-dark-3);
  }
  .sponsor__note a {
    color: var(--nf-green);
    text-decoration: underline;
  }
  .sponsor__list {
    flex: 1 1 360px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .sponsor__label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--on-dark-3);
  }
  .sponsor__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 14px;
  }
  .sponsor__logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    height: 132px;
    padding: 18px 22px;
    border-radius: var(--radius);
    background: #fff;
    color: var(--nf-navy);
    font-size: 20px;
    font-weight: 700;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .sponsor__logo:hover {
    text-decoration: none;
    color: var(--nf-navy);
    box-shadow: 0 0 0 3px var(--nf-green);
    transform: translateY(-2px);
  }
  /* Logos fill the tile: as wide as possible, capped in height so wide and square marks balance. */
  .sponsor__logo :global(.sponsor__img) {
    width: 100%;
    height: 100%;
    max-height: 92px;
    object-fit: contain;
  }
  .sponsor__logo--empty {
    grid-column: 1 / -1;
    height: 96px;
    background: transparent;
    border: 2px dashed rgba(76, 180, 140, 0.6);
    color: #fff;
    font-size: 17px;
  }
  .sponsor__logo--empty:hover {
    color: #fff;
  }
  .sponsor__logo--empty span {
    font-size: 14px;
    font-weight: 600;
    color: var(--nf-green);
  }
  .sponsor__backers {
    margin-top: 8px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sponsor__backers a {
    color: var(--nf-green);
    font-weight: 600;
  }
</style>
