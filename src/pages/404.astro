---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found">
  <section class="section">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="section-title">That page wandered off the bus.</h1>
      <p class="lead">It may have moved when we rebuilt the site. Try the <a href="/blog/">blog</a>, the <a href="https://docs.nanoframework.net">docs</a> or the <a href="/">home page</a>.</p>
    </div>
  </section>
</BaseLayout>
