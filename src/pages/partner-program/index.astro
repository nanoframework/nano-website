---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PartnerCard from '../../components/PartnerCard.astro';
import { ENGINEERING_PARTNERS } from '../../data/partners';
import { LINKS } from '../../data/site';
---
<BaseLayout
  title="Engineering partners"
  description="Companies with proven .NET nanoFramework expertise offering engineering services, consulting, training and support for commercial projects."
>
  <section class="section section--dark partners-hero">
    <div class="container">
      <p class="eyebrow">Partner program</p>
      <h1 class="section-title">Ship .NET nanoFramework products faster, with people who know it inside out.</h1>
      <p class="lead">
        Engineering partners are companies with proven .NET nanoFramework expertise. They offer engineering services,
        consulting, training and support to commercial users, helping you reduce development effort and time to market.
      </p>
      <div class="partners-hero__ctas">
        <a class="btn btn--primary" href={LINKS.joinPartners}>Become a partner</a>
        <a class="btn btn--ghost-dark" href={LINKS.contact}>Find the right partner</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Engineering partners</p>
      <h2 class="section-title">Services, consulting and training.</h2>
      <p class="lead">Companies that design, build and support products based on .NET nanoFramework.</p>
      <div class="grid partners-grid" style="--min: 300px">
        {ENGINEERING_PARTNERS.map((p) => <PartnerCard partner={p} />)}
      </div>
      <p class="see-also">
        Looking for boards or the technology behind the platform? See our{' '}
        <a href={LINKS.hardwareTechPartners}>hardware and technology partners →</a>
      </p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container join">
      <div class="join__text">
        <h2 class="section-title">Join the partner program.</h2>
        <p class="lead">
          Partners are listed here with their logo, a short description and contact details, and we match incoming
          requests to the best available partner. We look for companies that know .NET nanoFramework well, contribute
          to the project and are committed to supporting their customers.
        </p>
      </div>
      <div class="join__actions">
        <a class="btn btn--indigo btn--lg" href={LINKS.joinPartners}>How to apply</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .partners-hero h1 {
    max-width: 880px;
    font-size: clamp(34px, 4.6vw, 54px);
    letter-spacing: -1px;
  }
  .partners-hero__ctas {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .partners-grid {
    margin-top: 40px;
    gap: 24px;
  }
  .see-also {
    margin-top: 40px;
    color: var(--ink-2);
  }
  .see-also a {
    font-weight: 600;
  }
  .join {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 56px;
    align-items: center;
    justify-content: space-between;
  }
  .join__text {
    flex: 1 1 520px;
  }
</style>
